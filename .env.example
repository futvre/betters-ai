# Keep this key server-side. Never prefix it with NEXT_PUBLIC_.
API_FOOTBALL_KEY=replace_with_your_api_football_key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
NEXT_PUBLIC_APP_TIMEZONE=Europe/Athens

# Gemini API free tier (server-side only; never use NEXT_PUBLIC_)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
